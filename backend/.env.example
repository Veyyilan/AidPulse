# ─── AidPulse backend environment ─────────────────────────────────────────
# Copy to `.env` and fill in real values. Never commit `.env`.

# ─── Required ──────────────────────────────────────────────────────────────
# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/aidpulse
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/aidpulse?retryWrites=true&w=majority

# Secret used to sign JWTs. Must be a long random string. MUST change in prod.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime (short-lived).
JWT_EXPIRES_IN=1h

# Origin of the frontend, locked down for CORS + Socket.IO.
CLIENT_ORIGIN=http://localhost:5173

# ─── Government bootstrap ──────────────────────────────────────────────────
# On server start, a government user is created from these ONLY if no
# government user exists yet. It is never overwritten. The password is never
# logged. The account has mustChangePassword=true.
GOV_EMAIL=gov@example.gov.in
GOV_PASSWORD=change-me-gov-password

# ─── Identity adapter ──────────────────────────────────────────────────────
# basic (default) — no external verification; identityVerified stays false.
# digilocker      — OAuth authorization code + PKCE. Requires the variables
#                   below; until they are set the identity routes return 501.
IDENTITY_MODE=basic

# Only required when IDENTITY_MODE=digilocker.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=
# Optional overrides (sensible DigiLocker defaults are used when unset).
# DIGILOCKER_AUTHORIZE_URL=https://uidauth.digilocker.gov.in/digilocker/public/oauth2/authorize
# DIGILOCKER_TOKEN_URL=https://uidauth.digilocker.gov.in/digilocker/public/oauth2/token
# DIGILOCKER_PROFILE_URL=https://api.digilocker.gov.in/v2/open/oauth2/user/profile

# ─── Optional / Production ─────────────────────────────────────────────────
# HTTP port (Render sets this automatically via PORT env var)
PORT=4000

# Node environment: 'development' or 'production'
NODE_ENV=development

# Bcrypt cost (10 or more).
BCRYPT_ROUNDS=12

# A claim with no update for this many hours is force-released by the sweeper.
STALE_CLAIM_HOURS=4

# How often the sweeper runs (minutes). The spec default is 15.
STALE_SWEEP_MINUTES=15

# A pending need must be at least this old (minutes) to count toward a gap cell.
GAP_THRESHOLD_MINUTES=30

# Pending needs per 0.01-degree cell before a gap:alert is emitted.
GAP_CELL_THRESHOLD=3

# How often the gap scanner runs (minutes).
GAP_SCAN_MINUTES=5
