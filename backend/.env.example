# ─── AidPulse backend environment ─────────────────────────────────────────
# Copy to `.env` and fill in real values. Never commit `.env`.

# ─── Required ──────────────────────────────────────────────────────────────
# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/aidpulse
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/aidpulse?retryWrites=true&w=majority

# Secret used to sign JWTs. Use a long random string. MUST be changed in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime (short-lived).
JWT_EXPIRES_IN=1h

# Origin of the frontend, locked down for CORS + Socket.IO.
CLIENT_ORIGIN=http://localhost:5173

# ─── Optional / Production ─────────────────────────────────────────────────
# HTTP port (Render sets this automatically via PORT env var)
PORT=4000

# Node environment: 'development' or 'production'
NODE_ENV=development

# How long a claim may sit without an update before the sweeper force-releases it.
STALE_CLAIM_HOURS=4

# Shared secret required (x-api-key header) for the SMS inbound webhook.
SMS_API_KEY=change-me-sms-webhook-key

# Deployment region bounds used to reject out-of-region coordinates.
# Format: minLat,maxLat,minLng,maxLng  (defaults to the whole world if unset)
# Example (Lagos, Nigeria):
# DEPLOYMENT_REGION_BOUNDS=6.30,6.70,3.10,3.60
DEPLOYMENT_REGION_BOUNDS=

# Number of clustered pending reports in an area before a gap:alert is emitted.
GAP_CELL_THRESHOLD=3

# Enable geocoding for SMS without coordinates (requires external API, not implemented)
GEOCODE_ON_SMS=false